# =================================================================
# Zoya AI Assistant — Environment Configuration
# =================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =================================================================
# Admin Authentication & APK Release Management
# =================================================================
# Administrator login credentials for the APK upload & distribution portal
ADMIN_EMAIL="riyajulansari113b@gmail.com"
ADMIN_PASSWORD="CHANGE_ME_SECURE_ADMIN_PASSWORD"
ADMIN_JWT_SECRET="CHANGE_ME_RANDOM_LONG_SECRET_KEY_FOR_JWT_SIGNING"

# =================================================================
# Persistent Cloud Object Storage (for Vercel / Production)
# =================================================================
# Supported providers: "local" (for dev), "s3" (AWS S3), "r2" (Cloudflare R2), "vercel-blob"
STORAGE_PROVIDER="local"

# AWS S3 / Cloudflare R2 Credentials (when STORAGE_PROVIDER is "s3" or "r2")
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public base URL where uploaded APK files can be directly downloaded
# If empty, downloads stream securely through /api/releases/download?id=...
STORAGE_PUBLIC_URL=""
