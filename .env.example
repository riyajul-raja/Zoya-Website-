# =================================================================
# Zoya AI Assistant — Environment Configuration
# =================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLIC_SITE_URL: The production URL where this website is hosted.
PUBLIC_SITE_URL="https://zoyalive.vercel.app"
APP_URL="https://zoyalive.vercel.app"

# =================================================================
# Admin Authentication & APK Release Management
# =================================================================
# Secret PIN for unlocking the Admin Portal (REQUIRED — server fails closed if unset)
ZOYA_ADMIN_PIN="CHANGE_ME_ADMIN_PIN"
ADMIN_JWT_SECRET="CHANGE_ME_RANDOM_32_PLUS_BYTE_SECRET_KEY_FOR_ADMIN_JWT"

# =================================================================
# Offline Android License Entitlement Signing (Asymmetric ES256 / P-256)
# =================================================================
# REQUIRED (server-only, NEVER expose via VITE_* or commit to Git):
# PEM-encoded EC P-256 (prime256v1) private key (PKCS#8 or SEC1).
# Supports multi-line PEM, single-line with escaped \n, or base64-encoded PEM.
ENTITLEMENT_ES256_PRIVATE_KEY=""

# Optional stable key ID (`kid`) published in JWS headers and GET /api/licenses/jwks.
# If omitted, a deterministic public-only RFC 7638 thumbprint ID (`zoya-es256-...`) is derived.
ENTITLEMENT_ES256_KEY_ID=""

# Optional JSON array of retired/previous public EC P-256 JWKs for zero-downtime key rotation:
# e.g. '[{"kid":"zoya-es256-prev","kty":"EC","crv":"P-256","x":"...","y":"..."}]'
ENTITLEMENT_ES256_ADDITIONAL_PUBLIC_JWKS=""

# Dedicated AES-256-GCM authenticated encryption key for reversible admin license visibility (32+ chars)
LICENSE_KEY_ENCRYPTION_SECRET="CHANGE_ME_DEDICATED_AES256_GCM_ENCRYPTION_SECRET_32_BYTES"

# =================================================================
# Firebase Admin SDK (Cloud Firestore & FCM) — Project "zoya-updates"
# =================================================================
# Option 1 (Recommended): Full Firebase Service Account JSON (raw JSON string or base64-encoded)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Option 2: Individual Service Account fields (if FIREBASE_SERVICE_ACCOUNT_JSON is not used)
FIREBASE_PROJECT_ID="zoya-updates"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Canonical Cloud Firestore database ID in "zoya-updates" (Delhi / asia-south2)
FIRESTORE_DATABASE_ID="(default)"

# FCM topic subscribed to by the Android app (com.riyajul.zoya)
FCM_RELEASE_TOPIC="zoya_releases"

# =================================================================
# Stage 1 & 2: User Google OAuth 2.0 / OIDC & Server Sessions
# =================================================================
# Google Cloud OAuth 2.0 Web Application Client credentials (NEVER expose via VITE_*)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Exact Authorized Redirect URI configured in Google Cloud Console
GOOGLE_REDIRECT_URI="https://zoyalive.vercel.app/api/auth/google/callback"

# Dedicated 32+ byte random secret for encrypting OAuth state cookies & signing user session cookies
SESSION_SECRET="CHANGE_ME_RANDOM_32_PLUS_BYTE_USER_SESSION_SECRET"
