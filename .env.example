# =================================================================
# Zoya AI Assistant — Environment Configuration
# =================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLIC_SITE_URL: The production URL where this website is hosted.
PUBLIC_SITE_URL="https://zoya-website-eta.vercel.app"
APP_URL="https://zoya-website-eta.vercel.app"

# =================================================================
# Admin Authentication & APK Release Management
# =================================================================
# Secret PIN for unlocking the Admin Portal (defaults to "8825316434" if unset)
ZOYA_ADMIN_PIN="8825316434"
ADMIN_JWT_SECRET="CHANGE_ME_RANDOM_LONG_SECRET_KEY_FOR_JWT_SIGNING"

# Dedicated AES-256-GCM authenticated encryption key for reversible admin license visibility (32+ chars)
LICENSE_KEY_ENCRYPTION_SECRET="CHANGE_ME_DEDICATED_AES256_GCM_ENCRYPTION_SECRET_32_BYTES"

# =================================================================
# Firebase Admin SDK (Cloud Firestore & FCM) — Project "zoya-updates"
# =================================================================
# Option 1 (Recommended): Full Firebase Service Account JSON (raw JSON string or base64-encoded)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Option 2: Individual Service Account fields (if FIREBASE_SERVICE_ACCOUNT_JSON is not used)
FIREBASE_PROJECT_ID="zoya-updates"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Canonical Cloud Firestore database ID in "zoya-updates" (Delhi / asia-south2)
FIRESTORE_DATABASE_ID="(default)"

# FCM topic subscribed to by the Android app (com.riyajul.zoya)
FCM_RELEASE_TOPIC="zoya_releases"
