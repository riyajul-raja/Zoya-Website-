# =================================================================
# Zoya AI Assistant — Environment Configuration
# =================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLIC_SITE_URL: The production URL where this website is hosted.
PUBLIC_SITE_URL="https://zoya-website-opal.vercel.app"
APP_URL="https://zoya-website-opal.vercel.app"

# =================================================================
# Admin Authentication & APK Release Management
# =================================================================
# Secret PIN for unlocking the Admin Portal (defaults to "8825316434" if unset)
ZOYA_ADMIN_PIN="8825316434"
ADMIN_JWT_SECRET="CHANGE_ME_RANDOM_LONG_SECRET_KEY_FOR_JWT_SIGNING"

# =================================================================
# Firebase Cloud Messaging (FCM) — Android Release Push Notifications
# =================================================================
# Option 1 (Recommended): Full Firebase Service Account JSON (raw JSON string or base64-encoded)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Option 2: Individual Service Account fields (if FIREBASE_SERVICE_ACCOUNT_JSON is not used)
FIREBASE_PROJECT_ID="distinguished-arena-4wr9b"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# FCM topic subscribed to by the Android app (com.riyajul.zoya)
FCM_RELEASE_TOPIC="zoya_releases"
