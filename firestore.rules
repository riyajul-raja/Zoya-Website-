rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /releases/{releaseId} {
      allow read, write: if true;
    }
    match /apk_chunks/{chunkId} {
      allow read, write: if true;
    }
    match /fcm_devices/{deviceId} {
      allow read, write: if true;
    }
    match /fcm_notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
